# Copy to deploy/config.env (git-ignored) and fill in.
DEPLOY_HOST=user@your-server.example.com   # SSH target
DEPLOY_PATH=/opt/nearfit                   # where the project lives on the server
SSH_PORT=22
WEB_PORT=8080                              # host port the frontend container publishes

# Used by deploy/install-server-deps.sh (Debian/Ubuntu servers)
INSTALL_NGINX=0        # 1 = also install nginx (TLS termination in front of the containers)
INSTALL_CERTBOT=0      # 1 = also install certbot (HTTPS certificates)
